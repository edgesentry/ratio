# Copy values after SDK-docker-compose + L3 operator registration.
# Do not commit real secrets.

# RATIO_ODS_URL=http://127.0.0.1:8787
# RATIO_ODS_L2_URL=http://127.0.0.1:8090
# RATIO_ODS_L3_URL=http://127.0.0.1:8080
# L3 用（トークン取得）: API-Key-Sample
# RATIO_ODS_API_KEY=API-Key-Sample
# L2 ゲートウェイ用（VALID_API_KEYS）: l2/docker-compose.yml を参照（例 2dfd3409-…）
# RATIO_ODS_L2_API_KEY=2dfd3409-ce01-4451-96fa-7e10c9681422y
# RATIO_ODS_BEARER=
# RATIO_ODS_CLIENT_ID=system-auth-sample
# RATIO_ODS_CLIENT_SECRET=   # setup_l3 後の KEYCLOAK_CREDENTIALS_TOKEN_INTROSPECT_CLIENT_SECRET
# RATIO_ODS_USER_ID=ratio-poc
# RATIO_ODS_FGA_STORE_ID=   # setup_l2 後の FGA_STORE_ID
# RATIO_ODS_FGA_MODEL_ID=
# RATIO_ODS_OPERATOR_ID=    # JWT の operator_id（AuthZEN 有効時）
# RATIO_ODS_INDUSTRY_URI=http://host.docker.internal:8787
# RATIO_ODS_L2_MGMT_KEY=your-secret-management-api-key
